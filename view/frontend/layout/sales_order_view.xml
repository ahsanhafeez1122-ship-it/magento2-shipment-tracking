<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template"
                   name="ahsan.shipment.tracking.order"
                   template="AhsanHafeez_ShipmentTracking::order/tracking.phtml"
                   after="sales.order.info"
                   ifconfig="shipment_tracking/general/enabled">
                <arguments>
                    <argument name="tracking_view_model" xsi:type="object">AhsanHafeez\ShipmentTracking\ViewModel\Tracking</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
